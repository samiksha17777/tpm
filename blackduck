    conn = db()

    # --------------------------------------------------------
    # MASS ASSIGNMENT
    #
    # Client can potentially modify role/secret/etc.
    # --------------------------------------------------------

    fields = []

    values = []

    for key, value in data.items():

        fields.append(
            f"{key}=?"
        )

        values.append(value)

    values.append(
        session["user_id"]
    )

    query = f"""
        UPDATE users
        SET {",".join(fields)}
        WHERE id=?
    """

