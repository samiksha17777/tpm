# ============================================================
# TOKEN API
# ============================================================

@app.route("/api/token/profile")
def token_profile():

    token = request.headers.get(
        "Authorization",
        ""
    )

    if token.startswith("Bearer "):

        token = token.replace(
            "Bearer ",
            ""
        )

    try:

        decoded = base64.b64decode(
            token
        )

        data = json.loads(
            decoded
        )

        return jsonify({

            "authenticated": True,

            "user": data

        })

    except:

        return jsonify({
            "authenticated": False
        }), 401


